# Copy file này thành .env.local rồi điền giá trị thật.
# Mọi biến client bắt buộc có tiền tố VITE_ thì Vite mới expose ra import.meta.env.
# CẢNH BÁO: giá trị VITE_* bị inline vào bundle JS → public. Không đặt secret ở đây.

# Backend REST API (chỉ dùng khi VITE_ENABLE_GOOGLE_SHEET != "true")
# Code gọi tới `${VITE_API_BASE_URL}/api`
VITE_API_BASE_URL=https://api.example.com

# Google Sheets integration — phải đúng chuỗi "true" (viết thường) mới bật
VITE_ENABLE_GOOGLE_SHEET=true

# URL Web App (/exec) của Google Apps Script, xem scripts/google-apps-script/
VITE_GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Tuỳ chọn: Apps Script riêng để log lượt mở thiệp /invite.
# Bỏ trống thì fallback về VITE_GOOGLE_SHEET_SCRIPT_URL.
VITE_GOOGLE_SHEET_LOG_URL=
